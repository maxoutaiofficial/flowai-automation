{
  "manifest_version": 3,
  "name": "MaxOut AI Flow Connector",
  "short_name": "MaxOut AI",
  "version": "1.3.4",
  "description": "MaxOut AI: drives your open Google Flow tab from the local Flow Connector bridge.",
  "homepage_url": "https://github.com/maxoutaiofficial/flowai-automation",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "downloads",
    "storage",
    "alarms",
    "scripting",
    "sidePanel",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://127.0.0.1:8791/*",
    "ws://127.0.0.1:8791/*",
    "https://flow.google.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MaxOut AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
