{
  "manifest_version": 3,
  "name": "Flow Connector",
  "version": "1.2.4",
  "description": "Drives the open Google Flow tab from the local Flow Connector bridge.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "downloads", "storage", "alarms", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:8791/*",
    "ws://127.0.0.1:8791/*",
    "https://flow.google.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Flow Connector",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://flow.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
